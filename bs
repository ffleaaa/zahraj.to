<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎵 ZAHRAJ TO</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:"Trebuchet MS",Arial,sans-serif;color:#443b55;min-height:100vh;background:linear-gradient(135deg,#ffe4f1 0%,#dff3ff 35%,#fff6bd 65%,#e5ffd9 100%);overflow-x:hidden}
body::before{content:"🎵   🎶   🎼   ♬   🥁   🎹   🎻   ⭐   🌈   ♫";position:fixed;inset:0;z-index:-1;font-size:45px;line-height:150px;letter-spacing:25px;opacity:.08;animation:bgMove 20s linear infinite;pointer-events:none}
@keyframes bgMove{0%{transform:translateY(0)}50%{transform:translateY(-80px)}100%{transform:translateY(0)}}
header{background:rgba(255,255,255,.88);backdrop-filter:blur(10px);padding:18px 30px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 5px 20px rgba(80,60,100,.12);position:sticky;top:0;z-index:20}
.logo{font-size:30px;font-weight:900;color:#8e62d9}
.logo span{color:#ff6fae}
.back{display:none;border:none;background:#e9ddff;color:#704db0;padding:10px 18px;border-radius:20px;cursor:pointer;font-weight:bold}
main{max-width:1200px;margin:auto;padding:35px 20px}
.hero{text-align:center;padding:35px 10px 45px}
.hero h1{font-size:clamp(48px,8vw,82px);margin:0;color:#7957c9;text-shadow:4px 4px white;transition:.3s}
.hero p{font-size:23px;font-weight:bold;color:#655875}
.menu{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:22px}
.card{background:rgba(255,255,255,.94);border-radius:30px;padding:30px 22px;text-align:center;box-shadow:0 12px 30px rgba(80,60,100,.12);cursor:pointer;transition:.25s;border:3px solid transparent}
.card:hover{transform:scale(1.05) rotate(-1deg);box-shadow:0 18px 40px rgba(80,60,100,.2)}
.card:nth-child(1){border-color:#ffb6d5}
.card:nth-child(2){border-color:#a9dfff}
.card:nth-child(3){border-color:#d0b5ff}
.card:nth-child(4){border-color:#ffe28a}
.card:nth-child(5){border-color:#aee8b1}
.card:nth-child(6){border-color:#ffc7a8}
.card .icon{font-size:60px}
.card h2{margin:12px 0 8px}
.card p{margin:0;line-height:1.5}
.section{display:none}
.section.active{display:block;animation:appear .35s ease}
@keyframes appear{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}
.panel{background:rgba(255,255,255,.95);border-radius:30px;padding:28px;margin-bottom:25px;box-shadow:0 10px 30px rgba(80,60,100,.12)}
.panel h1,.panel h2{color:#7654c4}
.controls{display:flex;flex-wrap:wrap;gap:10px;margin:15px 0}
button,select{border:none;border-radius:18px;padding:13px 20px;font-size:16px;font-weight:bold;cursor:pointer;background:#e8ddff;color:#553c86;transition:.2s}
button:hover{transform:translateY(-2px);filter:brightness(.97)}
button.primary{background:#ff91bd;color:white}
button.blue{background:#9ddcff;color:#225a7a}
button.yellow{background:#ffe18a;color:#775b00}
button.green{background:#aee8b1;color:#27622c}
button.purple{background:#c9adff;color:#53308d}
button.red{background:#ff9c9c;color:#762929}
button.selected{outline:4px solid rgba(120,80,190,.2);transform:scale(1.04)}
.staff-container{background:white;border-radius:25px;padding:20px;margin:25px 0;box-shadow:inset 0 0 0 3px #eee7fa;overflow-x:auto}
#rhythmStaff{width:100%;min-width:760px;height:270px}
.staff-line{stroke:#45404c;stroke-width:2}
.bar-line{stroke:#45404c;stroke-width:3}
.note-head{fill:#24212a}
.note-stem{stroke:#24212a;stroke-width:3}
.note-beam{stroke:#24212a;stroke-width:6;stroke-linecap:round}
.note-flag{fill:none;stroke:#24212a;stroke-width:4}
.rest-symbol{font-size:36px;fill:#24212a}
.first-beat{fill:#ff5da2;stroke:#ff5da2}
.staff-beat-highlight{opacity:.12}
.rhythm-info{display:flex;justify-content:center;flex-wrap:wrap;gap:15px;margin:15px 0}
.info-pill{padding:10px 18px;border-radius:20px;background:#f3edff;font-weight:bold}
.tap-area{text-align:center;padding:10px 0 20px}
.tap-button{width:190px;height:190px;border-radius:50%;border:10px solid #ffb6d5;background:#ff78b1;color:white;font-size:28px;box-shadow:0 10px 0 #d6538d;margin:10px}
.tap-button:active{transform:translateY(8px);box-shadow:0 2px 0 #d6538d}
.tap-count{font-size:18px;font-weight:bold}
.status{padding:15px;border-radius:18px;background:#f4edff;margin-top:15px;font-weight:bold}
.status.success{background:#ddf8df;color:#25642b}
.status.error{background:#ffe1e1;color:#8a2d2d}
.accuracy{font-size:26px;font-weight:900;text-align:center;margin:15px}
.progress{height:20px;background:#eee;border-radius:20px;overflow:hidden;margin:15px 0}
.progress-bar{height:100%;background:linear-gradient(90deg,#ff9fc6,#a9dfff,#bca0ff);width:0%;transition:.5s}
.rhythm-lessons{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:15px}
.lesson{background:#faf7ff;border-radius:22px;padding:20px;border:2px solid #eee4ff}
.lesson-symbol{font-size:45px;text-align:center}
.lesson h3{text-align:center;color:#7654c4}
.lesson p{line-height:1.6}
.example{background:white;border-radius:15px;padding:12px;font-size:30px;text-align:center}
.real-stave-container{background:white;border-radius:25px;padding:15px 20px;margin:25px 0;box-shadow:inset 0 0 0 3px #eee7fa;overflow-x:auto}
#noteStave{width:100%;min-width:700px;height:260px}
.note-staff-line{stroke:#45404c;stroke-width:2.5}
.note-clef{fill:#443b55;font-family:"Bravura","Noto Music","Segoe UI Symbol","Arial Unicode MS",serif;font-weight:normal}
.note-head-real{fill:#24212a;stroke:#24212a;stroke-width:2}
.note-stem-real{stroke:#24212a;stroke-width:3}
.note-accidental-real{fill:#7654c4;font-family:"Segoe UI Symbol","Arial Unicode MS",sans-serif;font-size:30px;font-weight:bold}
.note-ledger{stroke:#45404c;stroke-width:2.5}
.note-name-real{fill:#7654c4;font-size:18px;font-weight:bold}
.answers{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.answers button{min-height:65px;background:#dff3ff}
.quiz-score{font-weight:bold;text-align:center}

/* INTERVALY */
.interval-letter-board{display:flex;justify-content:center;align-items:center;gap:18px;flex-wrap:wrap;background:#eef8ff;border-radius:25px;padding:28px;margin:20px 0}
.interval-letter-note{min-width:120px;padding:22px 28px;border-radius:22px;background:white;box-shadow:0 8px 0 #c9adff;font-size:52px;font-weight:900;color:#7654c4;text-align:center}
.interval-letter-arrow{font-size:38px;font-weight:900;color:#8b6bc9}
.interval-octave-note{text-align:center;min-height:28px;font-weight:900;color:#7654c4}
.interval-hint{background:#f5efff;padding:14px 18px;border-radius:18px;line-height:1.6}
.interval-build-card{display:flex;justify-content:center;align-items:center;gap:25px;padding:22px;background:#eef8ff;border-radius:25px;margin:20px 0}
.interval-build-note{font-size:48px;font-weight:900}
.interval-build-arrow{font-size:40px}
.interval-target-label{font-size:15px;font-weight:bold;opacity:.7;text-align:center}
.interval-target{font-size:32px;font-weight:900;color:#7654c4;text-align:center}
.interval-puzzle{background:linear-gradient(135deg,#fff6bd,#eef8ff);border-radius:24px;padding:clamp(12px,3vw,24px);margin:20px 0;overflow:hidden}
.interval-puzzle-row{display:flex;justify-content:center;align-items:stretch;gap:clamp(6px,2vw,12px);flex-wrap:wrap;margin:18px 0}
.interval-slot{width:clamp(66px,17vw,105px);min-height:76px;padding:8px 5px;box-sizing:border-box;border:3px dashed #c9adff;border-radius:17px;background:white;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:clamp(19px,4vw,30px);line-height:1.15;font-weight:900;color:#7654c4;text-align:center;overflow-wrap:anywhere}
.interval-slot.filled{border-style:solid;background:#f5efff}
.interval-slot small{font-size:11px;line-height:1.2;font-weight:700;color:#786a99}
.interval-puzzle-row .interval-letter-arrow{align-self:center;font-size:clamp(20px,4vw,32px)}
.lego-block{flex:0 1 68px;width:clamp(54px,12vw,68px);min-width:0;min-height:64px;padding:8px 4px;border:0;border-radius:14px;background:#ff91bd;color:#702449;font-size:clamp(17px,4vw,24px);line-height:1.15;font-weight:900;box-shadow:0 5px 0 #d6538d;white-space:normal;overflow-wrap:anywhere}
.lego-block:nth-child(2n){background:#9ddcff;color:#225a7a;box-shadow:0 5px 0 #67afd4}
.lego-block:nth-child(3n){background:#aee8b1;color:#27622c;box-shadow:0 5px 0 #70bb74}
.lego-block:hover{transform:translateY(-3px)}
.lego-label{text-align:center;font-weight:900;color:#7654c4;margin-top:8px;line-height:1.45}

/* AKORDY */
.chord-mode-tabs{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0 18px}
.chord-mode-tabs button{flex:1 1 130px}
.chord-puzzle{background:linear-gradient(135deg,#fff5bf,#f2eaff);border-radius:24px;padding:clamp(14px,3vw,24px);margin:16px 0}
.chord-puzzle-slots{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:20px 0}
.chord-slot{width:clamp(74px,18vw,105px);height:82px;border:3px dashed #bba6ed;border-radius:18px;background:#fff;display:flex;align-items:center;justify-content:center;font-size:clamp(24px,5vw,34px);font-weight:900;color:#7351b5;box-shadow:0 4px 0 #e2d6fb}
.chord-slot.filled{border-style:solid;background:#f5efff}
.chord-note-bank{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:18px 0}
.chord-note-block{width:clamp(55px,12vw,70px);min-height:62px;border:0;border-radius:14px;background:#ffb5d0;color:#71304d;font-size:23px;font-weight:900;box-shadow:0 5px 0 #db7da2;cursor:pointer}
.chord-note-block:nth-child(3n+2){background:#a8e1ff;color:#245a78;box-shadow:0 5px 0 #6eb5d8}
.chord-note-block:nth-child(3n){background:#b8edb8;color:#285e2a;box-shadow:0 5px 0 #79c47b}
.chord-note-block:disabled{opacity:.4;cursor:default;transform:none}
.chord-choice{min-width:120px;margin:5px}
.chord-explain-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.chord-explain-card{background:#f7f4ff;border-radius:18px;padding:16px;line-height:1.6}
.chord-explain-card h3{margin-top:0}
.chord-pieces{display:flex;justify-content:center;gap:15px;flex-wrap:wrap;margin:25px 0}
.piece{width:90px;height:90px;border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:bold;background:#ffd77e;cursor:pointer;transition:.2s}
.piece:hover{transform:scale(1.08) rotate(3deg)}

/* ODZNAKY */
.badges{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.badge{padding:25px;border-radius:25px;background:#f5efff;text-align:center;transition:.3s;opacity:.45}
.badge.unlocked{opacity:1;animation:badgePop .7s ease;background:#fff4bd}
@keyframes badgePop{0%{transform:scale(.5) rotate(-10deg)}60%{transform:scale(1.15) rotate(5deg)}100%{transform:scale(1)}}
.badge-icon{font-size:60px}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:100}
.confetti-piece{position:absolute;width:12px;height:18px;animation:fall 2.5s linear forwards}
@keyframes fall{0%{transform:translateY(-20px) rotate(0deg);opacity:1}100%{transform:translateY(110vh) rotate(720deg);opacity:0}}
footer{text-align:center;padding:30px;opacity:.7}
@media(max-width:700px){.answers{grid-template-columns:1fr}.panel{padding:20px}.hero h1{font-size:50px}.hero p{font-size:18px}}
</style>
</head>
